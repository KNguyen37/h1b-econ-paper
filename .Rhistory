library(dplyr)
library(stargazer)
# Subset the data to only include NAICS code 54
industry54_data <- final_dataset_complete %>%
filter(naics_2digit == "54")
# Create a post-treatment indicator for after the 2017 policy
industry54_data <- industry54_data %>%
mutate(post_policy = ifelse(year > 2017, 1, 0))
# Run time series models for industry 54
model_ind54_time <- lm(log_real_wage ~ post_policy + denial_rate,
data = industry54_data)
model_ind54_controls <- lm(log_real_wage ~ post_policy + denial_rate + unemployment_rate_winsorized +
offshoring_per_1000_employees_combined,
data = industry54_data)
# # Include trend analysis
# industry54_data <- industry54_data %>%
#   mutate(time_trend = year - min(year) + 1,
#          post_policy_trend = ifelse(year > 2017, year - 2017 + 1, 0))
#
# model_ind54_trend <- lm(log_real_wage ~ post_policy + post_policy_trend +
#                         time_trend + denial_rate + unemployment_rate_winsorized +
#                         offshoring_per_1000_employees_combined,
#                         data = industry54_data)
# Generate table for industry 54 specific models
ind54_table <- stargazer(model_ind54_time, model_ind54_controls,
# model_ind54_trend,
title = "Effects of H-1B Visa Restrictions on Industry 54",
column.labels = c("Basic", "With Controls", "With Trends"),
dep.var.labels = "Log Real Wage",
# covariate.labels = c("Post-Policy (2017+)", "Denial Rate",
#                     "Inflation Rate", "Unemployment Rate",
#                     "Offshoring per 1000 Employees",
#                     "Time Trend",
#                     "Post-Policy Trend"),
omit.stat = c("f", "ser"),
notes = "Analysis restricted to Industry 54 (Professional, Scientific, and Technical Services). Significance levels: * p<0.1, ** p<0.05, *** p<0.01.",
notes.append = FALSE,
model.numbers = TRUE,
digits = 3,
header = FALSE,
type = "text")
writeLines(ind54_table, "industry54_analysis.html")
# Create a visualization of the DiD effect
# Prepare data for visualization
plot_data <- final_dataset_complete %>%
group_by(year, high_dependency_median) %>%
summarize(avg_log_wage = mean(log_real_wage, na.rm = TRUE),
avg_denial_rate = mean(denial_rate, na.rm = TRUE),
.groups = "drop") %>%
mutate(treatment_group = ifelse(high_dependency_median, "High H-1B Dependency", "Low H-1B Dependency"))
# Plot the DiD
ggplot(plot_data, aes(x = year, y = avg_log_wage, color = treatment_group, group = treatment_group)) +
geom_line(size = 1) +
geom_vline(xintercept = 2017, linetype = "dashed", color = "red") +
annotate("text", x = 2017, y = min(plot_data$avg_log_wage), label = "Buy American, Hire American",
angle = 90, vjust = -0.5, hjust = -0.2) +
theme_minimal() +
labs(
title = "Difference-in-Differences: Log Real Wage by H-1B Dependency",
subtitle = "Before and After the 'Buy American, Hire American' Executive Order",
x = "Year",
y = "Average Log Real Wage",
color = "Industry Group"
)
ggsave("did_event_study.png", width = 10, height = 7, dpi = 300)
