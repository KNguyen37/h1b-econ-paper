library(stargazer)
library(broom)
library(dplyr)
# Define the models with consistent variable ordering
model1 <- lm(log_real_wage ~ did_median  + denial_rate,
data = final_dataset_complete)
# With fixed effects using factors
model2 <- lm(log_real_wage ~ did_median  + denial_rate +
inflation_rate + unemployment_rate_winsorized +
offshoring_per_1000_employees_combined +
factor(naics_2digit),
data = final_dataset_complete)
# With fixed effects using factors and controls
model3 <- lm(log_real_wage ~ did_top25 + denial_rate +
inflation_rate + unemployment_rate_winsorized +
offshoring_per_1000_employees_combined +
factor(naics_2digit),
data = final_dataset_complete)
# Create a publication-ready table using stargazer
stargazer_output <- stargazer(model1, model2, model3,
title = "Regression Results: Impact of H-1B Visa Restrictions on Wages",
column.labels = c("Base Model", "Median With Fixed Effects", "Top 25 With Fixed Effects"),
dep.var.labels = "Log Real Wage",
covariate.labels = c("DiD Median", "DiD Top 25%", "Denial Rate",
"Inflation Rate", "Unemployment Rate",
"Offshoring per 1000 Employees"),
omit = c("factor"),
omit.stat = c("f", "ser"),
notes = "Note: Fixed effects for industry (NAICS 2-digit) included but not shown.",
notes.append = FALSE,
model.numbers = TRUE,
digits = 3,
header = FALSE,
type = "text")
# Write the output to a file
writeLines(stargazer_output, "regression_results.html")
